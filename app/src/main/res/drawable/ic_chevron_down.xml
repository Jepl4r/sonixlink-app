<?xml version="1.0" encoding="utf-8"?>
<!-- The player's chevron, turned over: closing the now-playing screen is the
     opposite of opening it. -->
<rotate xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_chevron_up"
    android:fromDegrees="180"
    android:toDegrees="180"
    android:pivotX="50%"
    android:pivotY="50%" />
