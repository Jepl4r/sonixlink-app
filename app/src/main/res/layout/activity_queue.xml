<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/screen_bg">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/screen_bg"
            app:navigationIcon="@drawable/ic_back"
            app:titleTextColor="@color/text_primary"
            app:subtitleTextColor="@color/text_secondary">

            <!-- The corner buttons, as on the player's queue page: selection and
                 reordering, and in selection mode the bin and the way out. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/queueSelect"
                    style="@style/CornerButton"
                    android:src="@drawable/ic_select_mode"
                    android:contentDescription="@string/cd_select" />

                <ImageButton
                    android:id="@+id/queueReorder"
                    style="@style/CornerButton"
                    android:src="@drawable/ic_reorder"
                    android:contentDescription="@string/cd_reorder" />

                <ImageButton
                    android:id="@+id/queueRemove"
                    style="@style/CornerButton"
                    android:src="@drawable/ic_trash"
                    android:contentDescription="@string/cd_remove" />

                <ImageButton
                    android:id="@+id/queueClose"
                    style="@style/CornerButton"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/cd_close" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/queue_empty"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <!-- The volume pill, shown when the volume keys change the player's
         volume. -->
    <include
        android:id="@+id/volume"
        layout="@layout/volume_pill" />
</FrameLayout>
