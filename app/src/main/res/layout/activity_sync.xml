<?xml version="1.0" encoding="utf-8"?>
<!-- Syncing has a page of its own: until it is done there is nothing to show,
     and half a library behind a veil reads as a broken one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/screen_bg"
    android:padding="32dp">

    <TextView
        android:id="@+id/syncText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/syncing"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/syncDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/syncProgress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp" />

    <Button
        android:id="@+id/retryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/retry"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
