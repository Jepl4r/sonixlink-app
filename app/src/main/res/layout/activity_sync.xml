<?xml version="1.0" encoding="utf-8"?>
<!-- The sync page, shown while the library index downloads, before the
     library itself can be shown. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/screen_bg"
    android:padding="32dp">

    <TextView
        android:id="@+id/syncText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/syncing"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/syncDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/syncProgress"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp" />

    <!-- Download progress of the index. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/syncBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:max="1000"
        android:visibility="gone"
        app:trackCornerRadius="3dp"
        app:trackThickness="6dp"
        app:trackColor="@color/surface" />

    <TextView
        android:id="@+id/syncAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/retryButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="?attr/selectableItemBackground"
        android:text="@string/retry"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:visibility="gone" />
</LinearLayout>
